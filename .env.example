# Copy to .env.local and fill in. Never commit .env.local.

# --- Database ---
# Local dev: a SQLite file. Production: a Turso libSQL URL + auth token.
DATABASE_URL="file:./dev.db"
# DATABASE_AUTH_TOKEN=""

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Optional machine photo recognition (server-only) ---
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4.1-mini"
# Alternative: AI_PROVIDER="openrouter" and a vision + structured-output model.
OPENROUTER_API_KEY=""
OPENROUTER_VISION_MODEL="qwen/qwen3-vl-30b-a3b-instruct"
# Per account, per Lisbon calendar day; failed provider calls also count.
AI_DAILY_LIMIT="20"

# --- Seed accounts (used by `npm run db:seed`) ---
SEED_USER1_NAME="You"
SEED_USER1_EMAIL="you@example.com"
SEED_USER1_PASSWORD="changeme123"

SEED_USER2_NAME="Partner"
SEED_USER2_EMAIL="partner@example.com"
SEED_USER2_PASSWORD="changeme123"
