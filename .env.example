# Copy to .env.local and fill in. Never commit .env.local.

# --- Database ---
# Local dev: a SQLite file. Production: a Turso libSQL URL + auth token.
DATABASE_URL="file:./dev.db"
# DATABASE_AUTH_TOKEN=""

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Optional machine photo recognition (server-only) ---
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4.1-mini"
# Alternative: AI_PROVIDER="openrouter" and a vision + structured-output model.
OPENROUTER_API_KEY=""
OPENROUTER_VISION_MODEL="qwen/qwen3-vl-30b-a3b-instruct"
# Per account, per Lisbon calendar day; failed provider calls also count.
AI_DAILY_LIMIT="20"

# --- Seed accounts (used by `npm run db:seed`) ---
SEED_USER1_NAME="You"
SEED_USER1_EMAIL="you@example.com"
SEED_USER1_PASSWORD="changeme123"

SEED_USER2_NAME="Partner"
SEED_USER2_EMAIL="partner@example.com"
SEED_USER2_PASSWORD="changeme123"

# Transactional email (optional): enables email verification, password reset
# and the weekly report email. Without them those flows degrade gracefully.
# RESEND_API_KEY, EMAIL_FROM and APP_URL are one switch — set all three or none.
# Half-configuring arms the verification gate while sending links with no host,
# which locks every unverified account out of the app.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Gym Tracker <no-reply@oteudominio.pt>"
# APP_URL="https://mygym-tan.vercel.app"
# REGISTRATION_MAX_ATTEMPTS="10"  # registos por IP em 15 min (1-1000, omissao 10)
# CRON_SECRET="valor-aleatorio"  # protege /api/cron/weekly-report (Vercel envia como Bearer)
