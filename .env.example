# Copy to .env.local and fill in. Never commit .env.local.

# --- Database ---
# Local dev: a SQLite file. Production: a Turso libSQL URL + auth token.
DATABASE_URL="file:./dev.db"
# DATABASE_AUTH_TOKEN=""

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Seed accounts (used by `npm run db:seed`) ---
SEED_USER1_NAME="You"
SEED_USER1_EMAIL="you@example.com"
SEED_USER1_PASSWORD="changeme123"

SEED_USER2_NAME="Partner"
SEED_USER2_EMAIL="partner@example.com"
SEED_USER2_PASSWORD="changeme123"
